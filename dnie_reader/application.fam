App(
    appid="dnie_reader",
    name="IDentity",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="dnie_reader_app",
    stack_size=6 * 1024,  # el decodificador JPEG2000 corre en este hilo
    fap_category="NFC",
    targets=["f7"],
    fap_author="Dani",
    fap_weburl="https://github.com/daniqed/flipper-identity",
    fap_version="0.22",
    fap_icon="dnie_10px.png",
    fap_file_assets="assets", # csca.bin: claves CSCA de otros paises (se copia a la SD)
    fap_description="Read eIDs and ePassports and verify that they are genuine",
    fap_libs=["mbedtls"],  # SHA-1, AES y ECP del SDK
    # La libmbedtls.a del SDK no trae constant_time.o: lo compilamos nosotros (misma version 3.6.2)
    fap_private_libs=[
        Lib(
            name="mbedtls_ct",
            sources=["constant_time.c"],
            fap_include_paths=[".", "include"],
            cflags=["-Wno-unused-parameter"],
        ),
    ],
    requires=[
        "gui",
    ],
)
